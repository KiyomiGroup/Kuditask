# Postgres connection string (Supabase project connection string works here)
DATABASE_URL="postgresql://user:password@host:5432/kuditask"

# Random 32+ byte secret for signing session JWTs — generate with:
# openssl rand -base64 32
SESSION_SECRET=""

# Supabase (used for file storage of proof screenshots)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Paystack (withdrawals) — not wired up yet, see README "Pending"
PAYSTACK_SECRET_KEY=""

# One-time dev admin seed — only used by prisma/seed.ts, never read at runtime.
# For local/manual preview, admin@test.local / AdminPassword123! matches the
# tasker@test.local / TestPassword123! QA account prisma/seed.ts always creates.
ADMIN_SEED_EMAIL="admin@test.local"
ADMIN_SEED_PASSWORD="AdminPassword123!"
